# Bridge Configuration
BRIDGE_URL=https://ac-reconnect.com/db-bridge.php
BRIDGE_KEY=your-bridge-key-here

# Resume Link JWT Secret (must be at least 32 chars)
JWT_SECRET=your-secret-key-at-least-32-chars-long

# Optional: sends the coach notification when all 3 videos were watched to the end
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=Activecenter-Support <mail@mail.hl-support.biz>
POSTMARK_MESSAGE_STREAM=outbound
IDENTITY_ALERT_EMAIL=markus@global-sce.com

# Server-side Points Result update (do not expose this URL in browser code)
N8N_UPDATE_RESULT_URL=your-n8n-update-result-webhook-url
N8N_UPDATE_RESULT_SECRET=your-n8n-shared-secret

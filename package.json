{
  "name": "business-leads-quiz",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "node build.js",
    "start:server": "node server/app-server.js",
    "test": "node --test scripts/tests/*.test.js",
    "e2e:queue": "pnpm run build && node --test scripts/e2e/queue-failure.e2e.js",
    "verify": "node scripts/verify.js",
    "inventory:check": "node scripts/inventory/check-consumers.js",
    "smoke:resume": "node scripts/smoke-resume-link.js",
    "smoke:readonly": "node scripts/smoke-readonly.js",
    "lint": "eslint . --ext .js,.jsx && node scripts/lint-grenze.js",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json}\"",
    "check": "pnpm run lint && pnpm run format"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.59.1",
    "prettier": "^3.8.3"
  }
}

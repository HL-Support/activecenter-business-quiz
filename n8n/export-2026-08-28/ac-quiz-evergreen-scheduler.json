      "id": "cron-daily",
      "name": "Cron - Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://mautic.hl-support.biz/api/contacts?search=ac_nurture_stopped:0&limit=500&start=0",
        "authentication": "genericCredentialType",
        "options": {},
        "genericAuthType": "httpBasicAuth"
      },
      "id": "mautic-get-active-leads",
      "name": "Mautic - Get Active Nurture Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "Rt7PRC4IRSrjNt2L",
          "name": "Mautic Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst contacts = Object.values(response.contacts || {});\n\nconst today = new Date();\n\nreturn contacts\n  .filter(contact => {\n    const fields = contact.fields?.all || {};\n    const nurtureStoppedRaw = fields.ac_nurture_stopped;\n    if (nurtureStoppedRaw === true || nurtureStoppedRaw === 1 || nurtureStoppedRaw === '1') return false;\n\n    // Check if activation phase is complete: last phase email > 21 days ago\n    const submittedAt = fields.ac_last_form_submitted_at;\n    if (!submittedAt) return false;\n    const submitted = new Date(submittedAt);\n    const daysSinceSubmit = (today - submitted) / (1000 * 60 * 60 * 24);\n    if (daysSinceSubmit < 23) return false; // 21 days activation + 2 day buffer\n\n    return true;\n  })\n  .map(contact => {\n    const fields = contact.fields?.all || {};\n    const evergreen_position = Number(fields.ac_evergreen_position || 0);\n    return {\n      json: {\n        mauticContactId: contact.id,\n        contact_id: fields.ac_contact_id || '',\n        evergreen_position,\n        next_position: evergreen_position + 1,\n        profile: fields.ac_last_profile || '',\n        language: fields.ac_last_form_language || 'de'\n      }\n    };\n  });"
      },
      "id": "code-filter-and-map-evergreen",
      "name": "Code - Filter and Map Evergreen Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://mautic.hl-support.biz/api/segments/ac-nurture-evergreen/contact/' + $json.mauticContactId + '/add' }}",
        "authentication": "genericCredentialType",
        "options": {},
        "genericAuthType": "httpBasicAuth"
      },
      "id": "mautic-add-to-evergreen-segment",
      "name": "Mautic - Add to Evergreen Segment",

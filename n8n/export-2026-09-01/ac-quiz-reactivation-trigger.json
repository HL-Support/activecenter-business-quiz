    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mautic-evergreen-link-clicked",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-mautic-click",
      "name": "Webhook - Mautic Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "quiz-reactivation-trigger-001"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $json.body || $json;\n\n// Handle mautic.email_on_open webhook format:\n// {\"mautic.email_on_open\": [{..., \"lead\": {\"id\": 123, ...}}, ...]}\n// Also handle legacy custom format: {contact_id: \"...\", ...}\n\nlet contactId = null;\n\n// Mautic email_on_open payload\nconst openEvents = body['mautic.email_on_open'];\nif (Array.isArray(openEvents) && openEvents.length > 0) {\n  const event = openEvents[0];\n  const lead = event.lead || event.contact || {};\n  contactId = String(lead.id || lead.mauticContactId || '').trim();\n}\n\n// Fallback: legacy custom format\nif (!contactId) {\n  contactId = String(body.contact_id || body.mautic_contact_id || '').trim();\n}\n\nif (!contactId) {\n  return [{ json: { skip: true, reason: 'no contact_id in payload' } }];\n}\n\nreturn [{ json: { contactId, skip: false } }];\n"
      },
      "id": "code-parse-mautic-click",
      "name": "Code - Parse Mautic Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "if-skip",
      "name": "IF - Skip Invalid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://mautic.hl-support.biz/api/contacts/' + $json.contactId + '?includeCustomObjects=false' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "mautic-get-contact",
      "name": "Mautic - Get Contact + Segments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "Rt7PRC4IRSrjNt2L",
          "name": "Mautic Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// After fetching contact, check if they are in segment 16 (ac-nurture-evergreen)\nconst contactData = $json.contact || $json;\nconst fields = contactData.fields?.all || {};\n\n// Check nurture_stopped\nconst nurtureStoppedRaw = fields.ac_nurture_stopped;\nif (nurtureStoppedRaw === true || nurtureStoppedRaw === 1 || nurtureStoppedRaw === '1') {\n  return [{ json: { skip: true, reason: 'nurture_stopped' } }];\n}\n\n// Get the contact's segment memberships\n// We'll check via the lists property if available\nconst lists = contactData.lists || {};\nconst inEvergreen = Object.values(lists).some(l => l.alias === 'ac-nurture-evergreen');\n\nif (!inEvergreen) {\n  return [{ json: { skip: true, reason: 'not in evergreen segment' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    mauticContactId: contactData.id,\n    contactId: $('Code - Parse Mautic Event').item.json.contactId\n  }\n}];\n"
      },
      "id": "code-check-segment",
      "name": "Code - Check Evergreen Segment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

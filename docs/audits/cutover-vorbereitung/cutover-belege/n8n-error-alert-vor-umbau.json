      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "business-nurture-workflow-only",
              "leftValue": "={{ $json.workflow.id }}",
              "rightValue": "RqKSRTgFv8mv04H2",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "filter-business-nurture-workflow",
      "name": "Filter - Business Nurture Workflow",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        520,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://xlpiisbozpgmemxhtivj.supabase.co/rest/v1/rpc/record_nurture_failure",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "value": "return=minimal",
              "name": "Prefer"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const failure = $json || {};\n  const execution = failure.execution || {};\n  const error = execution.error || {};\n  return {\n    p_project_key: 'business_leads_quiz',\n    p_sequence_key: 'video_nurture',\n    p_workflow_id: String(failure.workflow?.id || 'RqKSRTgFv8mv04H2'),\n    p_workflow_version_id: failure.workflow?.activeVersionId || null,\n    p_execution_id: String(execution.id || 'unknown'),\n    p_error_code: String(error.name || error.cause?.name || 'workflow_failed').slice(0, 120),\n    p_error_node: String(execution.lastNodeExecuted || 'unknown').slice(0, 160),\n    p_error_message: String(error.message || 'Workflow failed').slice(0, 500),\n    p_occurred_at: new Date().toISOString()\n  };\n})() }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "id": "sb-log-nurture-failure",
      "name": "Supabase - Log Nurture Failure",

        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "postmarkApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ From: 'Activecenter Alert <mail@mail.hl-support.biz>', To: 'markus@global-sce.com', Subject: ('?? n8n Fehler: ' + (($json.workflow && $json.workflow.name) || 'Workflow')), HtmlBody: ('<h2 style=\"color:#b00\">n8n Workflow-Fehler</h2>'   + '<p><b>Workflow:</b> ' + (($json.workflow && $json.workflow.name) || '?') + ' (' + (($json.workflow && $json.workflow.id) || '') + ')</p>'   + '<p><b>Fehler-Node:</b> ' + (($json.execution && $json.execution.lastNodeExecuted) || '-') + '</p>'   + '<p><b>Meldung:</b> ' + (($json.execution && $json.execution.error && $json.execution.error.message) || '-') + '</p>'   + '<p><b>Execution:</b> ' + (($json.execution && $json.execution.id) || '-') + '</p>'   + '<p><a href=\"' + (($json.execution && $json.execution.url) || '#') + '\">In n8n oeffnen</a></p>'), TextBody: ('n8n Fehler in ' + (($json.workflow && $json.workflow.name) || '?') + ' / Node ' + (($json.execution && $json.execution.lastNodeExecuted) || '-') + ': ' + (($json.execution && $json.execution.error && $json.execution.error.message) || '-')), MessageStream: 'outbound'}) }}",
        "options": {}
      },
      "id": "pm-send",
      "name": "Postmark - Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "credentials": {
        "postmarkApi": {
          "id": "KJgdnWx7t6eirqzo",
          "name": "Postmark Typenanalyse"
        }
      }
    },
